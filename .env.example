# Vercel Project Settings → Environment Variables (Production + Preview)
NEXT_PUBLIC_SITE_URL=https://kindexlab.com
NEXT_PUBLIC_CONTACT_EMAIL=glory2wide@gmail.com
# Active market. Selects news providers, publisher trust lists, affiliate
# programs, locale and currency in one switch. KR | US | GB | DE | JP
NEXT_PUBLIC_MARKET_COUNTRY=KR
# Affiliate program ids. Only the ones the active market declares are used.
NEXT_PUBLIC_COUPANG_PARTNER_ID=your-partner-id
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
TRENDS_DATA_SOURCE=live
TRENDS_LIVE_REVALIDATE=60
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
INGEST_USER_AGENT=
# News retrieval for the editorial RAG context. Google News needs no key and
# runs in every market; Naver is KR-only (news + blog/web fallback); Serper covers
# web/youtube fallback when news is thin.
SERPER_API_KEY=
NEWS_RAG_ENABLED=0
NEWS_MAX_DOCS=8
NEWS_LOOKBACK_HOURS=72
# "오늘의 분석" RAG + 3-step chaining pipeline.
# Falls back to the deterministic composer whenever the chain cannot run.
ANALYSIS_CHAIN_ENABLED=1
# Hours before a cached column is refreshed. Stale entries render immediately
# and refresh in the background.
ANALYSIS_TTL_HOURS=12
# Total wall-clock budget for retrieval plus the three LLM steps.
ANALYSIS_TIMEOUT_MS=60000
# 1 forces pipeline tracing on, 0 silences it. Defaults to on outside production.
ANALYSIS_DEBUG=
# Ranking boards: 0 skips retrieval and the LLM, leaving seeded fallback boards.
BOARDS_CHAIN_ENABLED=1
BOARDS_TTL_HOURS=12
# Budget for one board: ranking, report, tone pass and the short-form script.
BOARDS_TIMEOUT_MS=120000
CRON_SECRET=replace-with-a-long-random-string
OPENAI_API_KEY=
# Fact extraction, drafting and the short-form script run on the cheap model.
OPENAI_MODEL=gpt-4o-mini
# Tone repair and length discipline run on the stronger model.
OPENAI_EDITOR_MODEL=gpt-4o
TRENDS_PERSIST_LIVE=0
# Durable store for generated columns, boards and 오늘의 분석. Vercel's filesystem
# is read-only at runtime, so without these the app falls back to the copies
# bundled at build time and nothing a cron writes survives.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional YouTube Data API key. When set, politics influencer scores add live
# concurrent viewers and recent VOD views. Seed channels still appear without it.
YOUTUBE_API_KEY=
# Extra UC… channel IDs, comma-separated, always collected as 정치 인플루언서.
POLITICS_YOUTUBE_SEED_IDS=

