# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# on-demand analysis cache (TTL data; Supabase is the durable store)
/src/data/analysis/
/src/data/boards/

# Google News handle→publisher URL cache. Local rebuild accelerator only:
# `flushUnwrapCache` refuses to write when VERCEL=1 and the resolver has no
# bundled fallback, so shipping it would add weight without helping production.
/src/data/news/

# typescript
*.tsbuildinfo
next-env.d.ts
